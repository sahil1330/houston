# Copy to .env and fill in. The key stays server-side; it is never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for the mission. Leave blank to use the default (claude-opus-5-5).
ANTHROPIC_MODEL=
# Optional: reasoning effort (low | medium | high). Lower = faster decisions. Default: medium.
# ANTHROPIC_EFFORT=medium
# Optional: backend port (default 8787) and simulation playback speed (default 2 = 2x real time).
# PORT=8787
# SIM_SPEED=2
