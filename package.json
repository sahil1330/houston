{
  "name": "houston-mission-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HOUSTON — AI Mission Control: Claude rescues a lunar lander through tool calls.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "dotenv": "^18.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
